## Copy this file to .streamlit/secrets.toml (same folder, drop the ".example")
## and fill in real values, to run the dashboard locally with:
##   streamlit run dashboard.py
##
## .streamlit/secrets.toml is gitignored - never commit your real secrets.
##
## When deploying on Streamlit Community Cloud instead, you don't need this
## file at all: paste these same two lines into the app's Settings -> Secrets
## box in the Streamlit Cloud website.

APIFY_API_TOKEN = "your_apify_token_here"
DASHBOARD_PASSWORD = "choose_a_password_here"
